<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuartzLauncher</AssemblyName>
    <RootNamespace>QuartzLauncher</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.7</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>

    <!--
      开发者署名：会写进 exe 的「属性 → 详细信息」和任务管理器的进程属性。
      换名字只改这里，不用动代码。
      注意：这不会改变 SmartScreen 弹窗里的「发行者」——那一行只有代码签名证书能填，
            未签名时 Windows 固定显示「发布者未知」。
    -->
    <Company>星落 LaunCher 开发组</Company>
    <Product>星落 LaunCher</Product>
    <AssemblyTitle>星落 LaunCher</AssemblyTitle>
    <Copyright>© 2026 星落 LaunCher 开发组</Copyright>

  </PropertyGroup>

  <!--
    私有功能覆盖：本地存在 Private/ 目录时启用完整功能（FULL_BUILD）。
    Private/ 目录不随仓库分发，公开仓库构建的是精简版（对应文件为占位实现）。
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/Private')">
    <DefineConstants>$(DefineConstants);FULL_BUILD</DefineConstants>
  </PropertyGroup>


  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="4.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\update-announcement.json">
      <Link>Launcher\update-announcement.json</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CleanPortablePublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishXmlDocs Include="$(PublishDir)**\*.xml" />
    </ItemGroup>
    <Delete Files="@(PublishXmlDocs)" />
  </Target>

  <Target Name="KeepWebView2FilesInLauncher" AfterTargets="Publish">
    <PropertyGroup>
      <WebView2LoaderPath>$(PublishDir)WebView2Loader.dll</WebView2LoaderPath>
      <WebView2LoaderTarget>$(PublishDir)Launcher\WebView2Loader.dll</WebView2LoaderTarget>
      <WebView2RuntimePath>$(PublishDir)runtimes</WebView2RuntimePath>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)Launcher" />
    <Copy SourceFiles="$(WebView2LoaderPath)" DestinationFiles="$(WebView2LoaderTarget)" SkipUnchangedFiles="true" Condition="Exists('$(WebView2LoaderPath)')" />
    <Delete Files="$(WebView2LoaderPath)" />
    <RemoveDir Directories="$(WebView2RuntimePath)" Condition="Exists('$(WebView2RuntimePath)')" />
  </Target>

</Project>
