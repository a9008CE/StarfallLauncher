<Window x:Class="QuartzLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:QuartzLauncher.Services"
        Title="星落LaunCher" Width="1050" Height="680"
        MinWidth="850" MinHeight="560"
         WindowStartupLocation="CenterScreen"
         WindowStyle="None"
         ResizeMode="NoResize"
         Background="{DynamicResource WindowBackgroundBrush}"
         BorderBrush="{DynamicResource WindowAccentBorderBrush}"
         BorderThickness="1"
        Foreground="{DynamicResource TextBrush}"
        Icon="Assets/app.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border BorderThickness="0" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid x:Name="WindowRoot" RenderTransformOrigin="0.5,0.5"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="WindowTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0" Height="{DynamicResource TopBarHeight}" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource WindowAccentBorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <DockPanel>
                    <Border Width="3" Height="18" Background="{DynamicResource PrimaryBrush}"
                            Margin="14,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource BrandText}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{DynamicResource UiFontFamily}"
                            Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Visibility="{DynamicResource WanderingEarthVisibility}"
                                Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="移山计划" FontSize="10" FontWeight="Bold"
                                   FontFamily="{DynamicResource UiDisplayFontFamily}"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="  //  ENGINE ARRAY ONLINE" FontSize="9"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{DynamicResource WindowBtn}"
                                ToolTip="最小化" Click="Minimize_Click" VerticalAlignment="Center"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Style="{DynamicResource CloseBtn}"
                                ToolTip="关闭" Click="Close_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>


                 <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="{DynamicResource SidebarWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                 <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                         BorderBrush="{DynamicResource WindowAccentBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,10,24,10">
                            <TextBlock Text="{DynamicResource BrandText}" FontSize="15" FontWeight="Bold"
                                       FontFamily="{DynamicResource UiDisplayFontFamily}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}"
                                Margin="24,4,24,8"/>

                        <StackPanel Grid.Row="2">
                            <StackPanel Visibility="{DynamicResource CyberpunkVisibility}"
                                        Margin="24,0,24,14">
                                <TextBlock Text="NIGHT CITY" FontSize="10" FontWeight="Bold"
                                           FontFamily="{DynamicResource UiDisplayFontFamily}"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="LOCAL ACCESS NODE // 2077" FontSize="9"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- 单行版：给首页腾出高度，避免把启动进度条挤下去 -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{DynamicResource WanderingEarthVisibility}"
                                        Margin="24,0,24,6">
                                <TextBlock Text="550W ENGINE ARRAY" FontSize="10" FontWeight="Bold"
                                           FontFamily="{DynamicResource UiDisplayFontFamily}"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="  //  MOUNTAIN MOVING PLAN  //  NOMINAL" FontSize="9"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  //  CORE TEMP 612K" FontSize="9"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 联机大厅专用侧栏：进入联机时替换主侧栏 -->
        <StackPanel x:Name="NavStackMultiplayer" Visibility="Collapsed">
            <RadioButton Style="{DynamicResource NavBtn}" GroupName="MpNav" Click="MPBack_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="返回" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="MPNavLobby" Style="{DynamicResource NavBtn}" GroupName="MpNav"
                         IsChecked="True" Click="MPNavLobby_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="大厅" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="MPNavChat" Style="{DynamicResource NavBtn}" GroupName="MpNav"
                         Click="MPNavChat_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="世界聊天" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="MPNavMyRooms" Style="{DynamicResource NavBtn}" GroupName="MpNav"
                         Click="MPNavMyRooms_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                    <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="我的房间" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="MPNavFriends" Style="{DynamicResource NavBtn}" GroupName="MpNav"
                         Click="MPNavFriends_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="好友" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <StackPanel x:Name="NavStack" Loaded="NavStack_Loaded">
                                <RadioButton Style="{DynamicResource NavBtn}" IsChecked="True"
                                             Click="NavHome_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="首页" VerticalAlignment="Center"/>
                                    </StackPanel>
                                 </RadioButton>
                                 <RadioButton Style="{DynamicResource NavBtn}"
                                              Click="NavVersions_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                     <TextBlock Text="版本库" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource NavBtn}"
                                         Click="NavServers_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="服务器" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource NavBtn}"
                                         Click="NavMultiplayer_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="联机大厅" VerticalAlignment="Center"/>
                                    <!-- 未读私聊红点 -->
                                    <Ellipse x:Name="MultiplayerUnreadDot" Width="8" Height="8"
                                             Fill="#FF3B30" Margin="6,0,0,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource NavBtn}"
                                         Click="NavModBrowser_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="资源中心" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource NavBtn}"
                                         Click="NavSettings_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="设置" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource NavBtn}"
                                         Click="NavHelp_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="帮助" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource NavBtn}"
                                         Click="NavMore_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Width="22" TextAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="更多功能" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{x:Static services:UpdateService.DisplayVersion}" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="24,0,24,8" Opacity="0.6"/>
                    </Grid>
                </Border>


                <Grid Grid.Column="1" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <!-- 顶部主题 HUD 已删除（高度 0）：给页面留出完整高度，避免把启动进度条挤下去 -->
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                      <Canvas IsHitTestVisible="False" Panel.ZIndex="0"
                              Visibility="{DynamicResource CyberpunkVisibility}" Grid.RowSpan="2">
                         <Border Width="220" Height="1" Background="{DynamicResource CyberpunkHudBrush}"
                                 Canvas.Left="32" Canvas.Top="18"/>
                         <Border Width="1" Height="120" Background="{DynamicResource CyberpunkHudBrush}"
                                 Canvas.Left="32" Canvas.Top="18"/>
                         <Border Width="180" Height="1" Background="{DynamicResource CyberpunkHudBrush}"
                                 HorizontalAlignment="Right" Canvas.Right="24" Canvas.Top="18"/>
                         <TextBlock Text="NC // SYSTEM ONLINE" FontFamily="{DynamicResource UiFontFamily}"
                                    FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                    Canvas.Right="26" Canvas.Top="25"/>
                         <TextBlock Text="ACCESS LEVEL: LOCAL" FontFamily="{DynamicResource UiFontFamily}"
                                    FontSize="9" Foreground="{DynamicResource PrimaryBrush}"
                                    Canvas.Left="44" Canvas.Bottom="20"/>
                         <Border Width="1" Height="80" Background="{DynamicResource CyberpunkHudBrush}"
                                 Canvas.Right="20" Canvas.Bottom="20"/>
                      </Canvas>
                       <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                               BorderBrush="{DynamicResource WanderingEarthHudBrush}" BorderThickness="0,0,0,1"
                               Visibility="{DynamicResource WanderingEarthVisibility}">
                           <Grid Margin="28,0,28,0">
                               <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="Auto"/>
                                   <ColumnDefinition Width="*"/>
                                   <ColumnDefinition Width="Auto"/>
                               </Grid.ColumnDefinitions>
                               <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                   <TextBlock Text="550W / CORE STATUS" FontFamily="{DynamicResource UiDisplayFontFamily}"
                                              FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                   <TextBlock Text="ORBITAL TRAJECTORY: LOCKED" FontFamily="{DynamicResource UiFontFamily}"
                                              FontSize="9" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                               </StackPanel>
                               <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                   <TextBlock Text="ENGINE 01  02  03  04  05" FontFamily="{DynamicResource UiFontFamily}"
                                              FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                   <TextBlock Text="PROPELLANT FLOW  ████████░░  82%" FontFamily="{DynamicResource UiFontFamily}"
                                              FontSize="9" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                               </StackPanel>
                           </Grid>
                       </Border>
                       <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"
                              Grid.Row="1" Background="Transparent" Margin="0" Panel.ZIndex="1"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True" UseLayoutRounding="True"
                            VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                 </Grid>
            </Grid>


             <Border Grid.Row="2" Height="{DynamicResource BottomBarHeight}" Background="{DynamicResource SidebarBrush}"
                     BorderBrush="{DynamicResource WindowAccentBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2B07;" FontFamily="Segoe UI Symbol" FontSize="20"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center" MaxWidth="400">
                            <TextBlock x:Name="QuoteText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="QuoteSource" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="DateTimeStack" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="DateTimeDate" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource PrimaryBrush}" Margin="4,3"/>
                        <TextBlock x:Name="DateTimeTime" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="TearTransitionLayer" Grid.RowSpan="3" Panel.ZIndex="900"
                  ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed">
                <Image x:Name="TearPieceA" Stretch="Fill"/>
                <Image x:Name="TearPieceB" Stretch="Fill"/>
            </Grid>
            <Grid x:Name="CinematicTransitionLayer" Grid.RowSpan="3" Panel.ZIndex="910"
                  ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed">
                <Canvas x:Name="CinematicPieces"/>
                <Border x:Name="CinematicGlow" Opacity="0">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46">
                            <GradientStop Color="#7A8EEBFF" Offset="0"/>
                            <GradientStop Color="#1C57D8E8" Offset="0.42"/>
                            <GradientStop Color="#00101A2D" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="CinematicSweep" Width="220" HorizontalAlignment="Left"
                        VerticalAlignment="Stretch" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0018D2D8" Offset="0"/>
                            <GradientStop Color="#D8B9FFFF" Offset="0.5"/>
                            <GradientStop Color="#0018D2D8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform X="-260"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
            <Image x:Name="ThemeTransitionOverlay" Grid.RowSpan="3"
                   Panel.ZIndex="1000" Stretch="Fill" IsHitTestVisible="False"
                   Visibility="Collapsed"/>

            <Border x:Name="DownloadToast" Grid.RowSpan="3" Grid.ColumnSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,76" Panel.ZIndex="950"
                    Style="{DynamicResource CardStyle}" Padding="14,10"
                    Cursor="Hand" Visibility="Collapsed"
                    RenderTransformOrigin="1,1">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel MouseLeftButtonUp="DownloadToast_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下载完成" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="· 单击打开文件夹" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,1"/>
                    </StackPanel>
                    <TextBlock x:Name="ToastName" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               MaxWidth="300" TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
