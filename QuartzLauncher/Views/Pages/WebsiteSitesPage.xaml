<Page x:Class="QuartzLauncher.Views.Pages.WebsiteSitesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="WEB SITES" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="网站站点" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="快速打开 Minecraft、Mod 资源和相关管理页面。" Style="{DynamicResource PageSubtitle}"/>

            <TextBlock Text="星落站点" Style="{DynamicResource SectionHeader}" Margin="0,22,0,8"/>
            <WrapPanel x:Name="StarfallSitesPanel"/>

            <TextBlock Text="常用资源站" Style="{DynamicResource SectionHeader}" Margin="0,22,0,8"/>
            <WrapPanel x:Name="ResourceSitesPanel"/>

            <TextBlock Text="启动器相关" Style="{DynamicResource SectionHeader}" Margin="0,22,0,8"/>
            <WrapPanel x:Name="LauncherSitesPanel"/>

            <Border Style="{DynamicResource CardStyle}" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="自定义站点" Style="{DynamicResource SectionHeader}"/>
                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8"
                            Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="名称" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>：站点显示名称，如"Modrinth"。<LineBreak/>
                                <Run Text="网址" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>：完整的 HTTP/HTTPS 链接，如 https://modrinth.com/<LineBreak/>
                                <Run Text="图标" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>：自动从网站根目录获取 favicon，无需手动填写。<LineBreak/>
                                <Run Text="操作" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>：点击卡片打开网站，点右上角 × 删除。
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SiteNameBox" Grid.Column="0" Height="32"
                                 Padding="8,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBox x:Name="SiteUrlBox" Grid.Column="1" Height="32" Margin="8,0"
                                 Padding="8,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource InputBgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <Button Grid.Column="2" Content="添加" Style="{DynamicResource BtnPrimary}"
                                Padding="12,4" Click="AddSite_Click"/>
                    </Grid>
                    <StackPanel x:Name="CustomSitesPanel"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
