<Page x:Class="QuartzLauncher.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behavior="clr-namespace:QuartzLauncher.Services"
      Background="Transparent">
    <Page.Resources>
        <!-- 登录方式卡片：整块可点，选中时描边变主色、底色变浅蓝，右边展开字段 -->
        <Style x:Key="AuthCard" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="{DynamicResource InputCornerRadius}"
                                Background="{DynamicResource CardSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" Padding="14,12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 单选圈：选中时内圈填实 -->
                                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,2,12,0"
                                      VerticalAlignment="Top">
                                    <Ellipse x:Name="DotRing" StrokeThickness="1.5"
                                             Stroke="{DynamicResource TextMutedBrush}"/>
                                    <Ellipse x:Name="DotFill" Width="8" Height="8" Visibility="Collapsed"
                                             Fill="{DynamicResource PrimaryBrush}"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource NavActiveBgBrush}"/>
                                <Setter TargetName="DotRing" Property="Stroke"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="DotFill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="AuthHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid Margin="36,16,36,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" Focusable="False">
                <StackPanel>

                    <!-- ═══════════════ 页头 ═══════════════ -->
                    <TextBlock Text="STARFALL" Style="{DynamicResource PageEyebrow}"/>
                    <TextBlock Text="欢迎回来，指挥官" Style="{DynamicResource PageTitle}"/>
                    <TextBlock Text="版本、资源、好友，都在这里。" Style="{DynamicResource PageSubtitle}"
                               Margin="0,0,0,10"/>

                    <!-- ═══════════════ 当前实例大卡片 ═══════════════ -->
                    <Border x:Name="InstanceHeroCard" Style="{DynamicResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧强调条：跟「进入游戏」按钮同一个主色渐变，跟着主题走 -->
                            <Border Grid.Column="0" Width="4" Margin="0,16,0,16" CornerRadius="2"
                                    Background="{DynamicResource GlassPrimaryBrush}"/>

                            <!-- 实例图标：有自定义图标时换成图片刷（Border 会把背景裁成圆） -->
                            <Border Grid.Column="1" x:Name="InstanceIconHost" Width="88" Height="88"
                                    CornerRadius="44" Margin="18,18,16,18"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="InstanceIconGlyph" Text="&#xE7B8;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="34"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 实例信息 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,18,18,18">
                                <TextBlock Text="当前实例" FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="InstanceTitle" Text="还没有可用的版本" FontSize="22"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="InstanceMeta" Text="先去「版本列表」装一个吧" FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,9,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="InstanceInfo" Text="" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 选择版本 + 进入游戏 -->
                            <StackPanel Grid.Column="3" Width="268" VerticalAlignment="Center"
                                        Margin="0,18,18,18">
                                <TextBlock Text="选择版本" FontSize="11.5" Margin="2,0,0,6"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox x:Name="InstanceSelector" Height="34"
                                          TextSearch.TextPath="Content"
                                          SelectionChanged="Instance_Changed"/>
                                <Button x:Name="LaunchBtn" Content="进入游戏" Style="{DynamicResource BtnPrimary}"
                                        Height="46" FontSize="15" Margin="0,10,0,0" IsEnabled="False"
                                        Click="Launch_Click" Padding="16,8"/>
                                <Button x:Name="ForceStopBtn" Content="强制终止" Style="{DynamicResource BtnDanger}"
                                        Height="46" FontSize="15" Margin="0,10,0,0" Visibility="Collapsed"
                                        Click="ForceStop_Click" Padding="16,8"/>
                                <Button x:Name="StopBtn" Content="终止游戏" Style="{DynamicResource BtnDanger}"
                                        Height="46" FontSize="15" Margin="0,10,0,0" Visibility="Collapsed"
                                        Click="Stop_Click" Padding="16,8"/>
                                <TextBlock x:Name="LaunchStatusDetail" Text="选择版本后点击「进入游戏」"
                                           FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════ 更新公告 / 游戏日志（同一条，二选一） ═══════════════ -->
                    <Border x:Name="HomeNoticeCard" Style="{DynamicResource CardStyle}" Padding="0"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Width="4" Margin="0,12,0,12" CornerRadius="2"
                                    Background="{DynamicResource PrimaryBrush}"/>

                            <!-- 窄条：默认只看这一行，点「展开」才拉出正文 -->
                            <DockPanel x:Name="AnnouncementPanel" Grid.Row="0" Grid.Column="1"
                                       Margin="16,12,16,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="游戏日志" Style="{DynamicResource BtnBase}"
                                            Padding="11,5" FontSize="12" Click="ExpandLog_Click"
                                            ToolTip="查看最近一次启动的游戏日志"/>
                                    <Button x:Name="AnnouncementToggleBtn" Content="展开"
                                            Style="{DynamicResource BtnBase}" Padding="11,5"
                                            Margin="8,0,0,0" FontSize="12"
                                            Click="AnnouncementToggle_Click"/>
                                    <Button x:Name="AnnouncementReadButton" Content="已读"
                                            Style="{DynamicResource BtnBase}" Padding="11,5"
                                            Margin="8,0,0,0" FontSize="12"
                                            ToolTip="标记这版公告为已读，整条收起来；再点一次可翻出来"
                                            Click="AnnouncementRead_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="更新公告" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="AnnouncementVersionText" Text="QuartzLauncher"
                                                   FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AnnouncementSummaryText" Text="" FontSize="12"
                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 正文 -->
                            <ScrollViewer x:Name="AnnouncementContent" Grid.Row="1" Grid.Column="1"
                                          Margin="16,0,16,14" MaxHeight="240" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel Margin="0,2,10,2">
                                    <TextBlock x:Name="AnnouncementTitleText" Text="更新内容"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="AnnouncementNotesText" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" LineHeight="21"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 日志模式：盖住整张卡 -->
                            <DockPanel x:Name="LogPanel" Grid.Row="0" Grid.RowSpan="2"
                                       Grid.Column="0" Grid.ColumnSpan="2" Margin="16,12,16,14"
                                       Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="分析日志" Style="{DynamicResource BtnBase}" Padding="10,5"
                                                Click="AnalyzeLog_Click" FontSize="12"/>
                                        <Button Content="清空" Style="{DynamicResource BtnBase}" Padding="10,5"
                                                Margin="8,0,0,0" Click="ClearLog_Click" FontSize="12"
                                                ToolTip="仅清空当前显示，不删除日志文件"/>
                                        <Button Content="收起" Style="{DynamicResource BtnBase}" Padding="10,5"
                                                Margin="8,0,0,0" Click="CollapseLog_Click" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="游戏日志" Style="{DynamicResource SectionHeader}"
                                               Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <RichTextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                                             MinHeight="180" Padding="4"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════ 快捷入口 ═══════════════ -->
                    <TextBlock Text="快捷入口" Style="{DynamicResource SectionHeader}" Margin="2,12,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="16,14"
                                Cursor="Hand" MouseLeftButtonUp="QuickHelp_Click" ToolTip="使用文档与常见问题">
                            <StackPanel>
                                <TextBlock Text="帮助" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="使用文档 · 常见问题" FontSize="12" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="第一次用，从这里开始" FontSize="11.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" x:Name="QuickVersionsCard" Style="{DynamicResource CardStyle}"
                                Padding="16,14" Cursor="Hand" MouseLeftButtonUp="QuickVersions_Click"
                                ToolTip="查看与管理已安装的版本">
                            <StackPanel>
                                <TextBlock Text="版本列表" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="QuickVersionsHint" Text="查看已安装的版本" FontSize="12"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="装新版本、切换、删除" FontSize="11.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{DynamicResource CardStyle}" Padding="16,14"
                                Cursor="Hand" MouseLeftButtonUp="QuickVersionSettings_Click"
                                ToolTip="隔离、Java 与启动参数">
                            <StackPanel>
                                <TextBlock Text="版本设置" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="隔离 · Java · 启动参数" FontSize="12" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="针对当前选中的版本" FontSize="11.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════ 底部状态条 ═══════════════ -->
            <!-- 钉在页面底部、不随内容滚动；版本号在侧栏、时间在窗口底栏，这里不重复放 -->
            <Border x:Name="LaunchStatusCard" Grid.Row="1" Style="{DynamicResource CardStyle}"
                    Margin="0,10,0,0" Padding="16,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7"
                                 VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="LaunchStatusText" Grid.Column="1" Text="请启动游戏"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="9,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="AmbientStatusText" Grid.Column="2" Text="" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,14,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LaunchStatusPercent" Grid.Column="3" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="LaunchProgressBar" Height="3" Minimum="0" Maximum="100"
                                 Value="0" Margin="0,10,0,0" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════ 登录切换浮层（卡片式，选中的那张展开字段） ═══════════════ -->
        <Border x:Name="LoginOverlay" Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush x:Name="OverlayBrush" Color="Black" Opacity="0"/>
            </Border.Background>
            <Grid Background="Transparent" MouseLeftButtonDown="LoginOverlay_Click">
                <Border x:Name="LoginCard" Style="{DynamicResource CardStyle}"
                        Width="430" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="24" Background="{DynamicResource ReadablePanelBrush}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CardScale" ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform x:Name="CardTranslate" Y="20"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="切换登录方式" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="三种方式任选其一，登录后可在首页随时切换" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Padding="0,0,6,0">
                            <StackPanel>

                                <!-- ── 离线模式 ── -->
                                <RadioButton x:Name="PopupOfflineRadio" Style="{StaticResource AuthCard}"
                                             GroupName="PopupAuth" Click="PopupAuth_Click" Tag="offline"
                                             AutomationProperties.Name="离线模式">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="离线模式" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="不需要账号，填个名字就能玩"
                                                       FontSize="11.5" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                        <Grid x:Name="PopupOfflinePanel" Visibility="Visible" Opacity="1"
                                              Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="玩家名"
                                                       Style="{StaticResource AuthFieldLabel}"/>
                                            <TextBox Grid.Row="1" x:Name="PopupOfflineNameBox" FontSize="14"
                                                     behavior:InputValidationBehavior.IdentifierOnly="True"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="只能用字母、数字和下划线，这会作为你在游戏里的名字"
                                                       Style="{StaticResource AuthHint}"/>
                                        </Grid>
                                    </StackPanel>
                                </RadioButton>

                                <!-- ── 第三方登录 ── -->
                                <RadioButton x:Name="PopupExternalRadio" Style="{StaticResource AuthCard}"
                                             GroupName="PopupAuth" Click="PopupAuth_Click" Tag="external"
                                             AutomationProperties.Name="第三方登录">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="第三方登录" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="认证服务器 · 账号 · 密码"
                                                       FontSize="11.5" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                        <Grid x:Name="PopupExternalPanel" Visibility="Collapsed" Opacity="0"
                                              MaxHeight="0" Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="认证服务器"
                                                       Style="{StaticResource AuthFieldLabel}"/>
                                            <TextBox Grid.Row="1" x:Name="PopupAuthServerBox" FontSize="14"
                                                     Text="https://littleskin.cn/api/yggdrasil"/>
                                            <TextBlock Grid.Row="2" Text="账号" Margin="0,10,0,5"
                                                       Style="{StaticResource AuthFieldLabel}"/>
                                            <TextBox Grid.Row="3" x:Name="PopupAuthAccountBox" FontSize="14"/>
                                            <TextBlock Grid.Row="4" Text="密码" Margin="0,10,0,5"
                                                       Style="{StaticResource AuthFieldLabel}"/>
                                            <Grid Grid.Row="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox Grid.Column="0" x:Name="PopupAuthPasswordBox"
                                                             FontSize="14" Tag="password"/>
                                                <TextBox Grid.Column="0" x:Name="PopupAuthPasswordShow"
                                                         FontSize="14" Visibility="Collapsed" Tag="password"/>
                                                <Button Grid.Column="1" x:Name="PasswordToggleBtn" Width="32"
                                                        Height="32" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Click="PasswordToggle_Click"
                                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock x:Name="PasswordToggleIcon" Text="👁" FontSize="14"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </RadioButton>

                                <!-- ── 正版登录 ── -->
                                <RadioButton x:Name="PopupMicrosoftRadio" Style="{StaticResource AuthCard}"
                                             GroupName="PopupAuth" Click="PopupAuth_Click" Tag="microsoft"
                                             AutomationProperties.Name="正版登录">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="正版登录" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="浏览器网页授权"
                                                       FontSize="11.5" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="PopupMicrosoftStatus" FontSize="11.5" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <StackPanel x:Name="PopupMicrosoftPanel" Visibility="Collapsed"
                                                    Opacity="0" MaxHeight="0" Margin="0,12,0,0">
                                            <TextBlock Text="已保存的正版账户"
                                                       Style="{StaticResource AuthFieldLabel}"/>
                                            <Grid Height="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="PopupMicrosoftAccountBox" Grid.Column="0"
                                                          Height="32"/>
                                                <Button x:Name="PopupMicrosoftUseBtn" Grid.Column="2"
                                                        Content="使用账户" Style="{DynamicResource BtnBase}"
                                                        Padding="10,4" Click="UseMicrosoftAccount_Click"/>
                                            </Grid>
                                            <TextBlock Text="网页授权完成后会自动保存，可在这里快速切换。"
                                                       Style="{StaticResource AuthHint}"/>
                                            <Button x:Name="PopupMicrosoftCancelBtn" Content="取消网页授权"
                                                    Style="{DynamicResource BtnDanger}" Padding="10,4"
                                                    Margin="0,10,0,0" HorizontalAlignment="Center"
                                                    Click="CancelMicrosoftLogin_Click" Visibility="Collapsed"/>
                                            <Button x:Name="PopupMicrosoftRemoveBtn" Content="移除所选账户"
                                                    Style="{DynamicResource BtnBase}" Padding="10,4"
                                                    Margin="0,10,0,0" HorizontalAlignment="Center"
                                                    Click="RemoveMicrosoftAccount_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 底部：左边放账号相关的次要操作，右边是主操作 -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="自定义头像" Style="{DynamicResource BtnBase}" Padding="10,5"
                                        FontSize="11.5" Click="PickAvatar_Click"
                                        ToolTip="选一张 PNG 当头像；不选就自动用正版皮肤脸"/>
                                <Button x:Name="ClearAvatarBtn" Content="恢复默认" Style="{DynamicResource BtnBase}"
                                        Padding="10,5" FontSize="11.5" Margin="6,0,0,0"
                                        Click="ClearAvatar_Click" Visibility="Collapsed"
                                        ToolTip="改回自动获取的头像（正版皮肤脸 / 名字首字母）"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="取消" Style="{DynamicResource BtnBase}"
                                    Height="38" Padding="20,0" Click="LoginCancel_Click"/>
                            <Button Grid.Column="3" x:Name="PopupLoginBtn" Content="登录"
                                    Style="{DynamicResource BtnPrimary}" Height="38" Padding="24,0"
                                    Click="PopupLogin_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="LaunchSuccessToast" Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,24" Panel.ZIndex="999"
                Style="{DynamicResource CardStyle}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x2714;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="游戏启动成功" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="正在等待游戏窗口出现，请稍候..." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
