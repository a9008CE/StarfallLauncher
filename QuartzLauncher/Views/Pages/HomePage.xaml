<Page x:Class="QuartzLauncher.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behavior="clr-namespace:QuartzLauncher.Services"
      Background="Transparent">
    <Grid>
        <Grid Margin="36,6,36,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="HOME" Style="{DynamicResource PageEyebrow}"/>
                <TextBlock Text="开始游戏" Style="{DynamicResource PageTitle}"/>
                <TextBlock Text="选择实例并启动 Minecraft。" Style="{DynamicResource PageSubtitle}"/>

                <Border x:Name="AccountExpiredCard" Visibility="Collapsed" Margin="0,12,0,0"
                        Style="{DynamicResource CardStyle}" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="账号登录状态已过期（好友、私聊、在线状态需要重新登录）" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
                        <Button Content="重新登录" Style="{DynamicResource BtnPrimary}" Height="30"
                                Padding="14,2" Margin="14,0,0,0" Click="ReLoginFromHome_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="320"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                        <Grid>
                            <DockPanel x:Name="AnnouncementPanel">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="展开日志" Style="{DynamicResource BtnBase}"
                                            Padding="10,5" Click="ExpandLog_Click" FontSize="12"/>
                                    <TextBlock Text="更新公告" Style="{DynamicResource SectionHeader}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="4,2,12,4">
                                        <TextBlock x:Name="AnnouncementVersionText" Text="QuartzLauncher"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="AnnouncementTitleText" Text="更新内容"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,14,0,6"/>
                                        <TextBlock x:Name="AnnouncementNotesText"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" LineHeight="21"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <DockPanel x:Name="LogPanel" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="分析日志" Style="{DynamicResource BtnBase}" Padding="10,5"
                                                Click="AnalyzeLog_Click" FontSize="12"/>
                                        <Button Content="清空" Style="{DynamicResource BtnBase}" Padding="10,5"
                                                Margin="8,0,0,0" Click="ClearLog_Click" FontSize="12"
                                                ToolTip="仅清空当前显示，不删除日志文件"/>
                                        <Button Content="收起" Style="{DynamicResource BtnBase}" Padding="10,5"
                                                Margin="8,0,0,0" Click="CollapseLog_Click" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="游戏日志" Style="{DynamicResource SectionHeader}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <RichTextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent"
                                             Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                                             Padding="4"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6"
                                        Background="{DynamicResource PrimaryBrush}" Cursor="Hand"
                                        MouseLeftButtonDown="Avatar_Click"
                                        x:Name="AvatarBorder" Margin="0,0,14,0">
                                    <TextBlock x:Name="AvatarText" Text="?" FontSize="16" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ProfileName" Text="离线模式" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <Border Background="{DynamicResource NavActiveBgBrush}" CornerRadius="6"
                                                Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileBadge" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="ProfileInfo" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="切换" Style="{DynamicResource BtnBase}"
                                        Padding="14,6" Click="SwitchAccount_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ProgressBorder" Style="{DynamicResource CardStyle}" Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="下载进度" Style="{DynamicResource SectionHeader}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ProgressText" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="ProgressDetail" FontSize="12" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="版本列表"
                                            Style="{DynamicResource BtnBase}" Height="30" Padding="10,4"
                                            FontSize="11" Click="VersionList_Click"/>
                                    <TextBlock Text="选择版本" Style="{DynamicResource SectionHeader}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ComboBox x:Name="InstanceSelector" Height="36"
                                          TextSearch.TextPath="Content"
                                           SelectionChanged="Instance_Changed"/>
                                <TextBlock x:Name="InstanceInfo" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,10,0,16"/>
                                <Button x:Name="LaunchBtn" Content="启动游戏" Style="{DynamicResource BtnPrimary}"
                                        Height="46" FontSize="14" MinWidth="160" IsEnabled="False" Click="Launch_Click"
                                        Padding="16,8"/>
                                <Button x:Name="ForceStopBtn" Content="强制终止" Style="{DynamicResource BtnDanger}"
                                        Height="46" FontSize="14" MinWidth="160" Visibility="Collapsed"
                                        Click="ForceStop_Click" Padding="16,8"/>
                                <Button x:Name="StopBtn" Content="终止游戏" Style="{DynamicResource BtnDanger}"
                                        Height="46" FontSize="14" MinWidth="160" Visibility="Collapsed"
                                        Click="Stop_Click" Padding="16,8"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.45*"/>
                                        <ColumnDefinition Width="0.1"/>
                                        <ColumnDefinition Width="0.45*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="快速安装" Style="{DynamicResource BtnBase}"
                                            Height="36" Padding="20,0" Click="QuickInstall_Click"/>
                                    <Button Grid.Column="2" Content="版本设置" Style="{DynamicResource BtnBase}"
                                            Height="36" Padding="20,0" Click="VersionSettings_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LaunchStatusCard" Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LaunchStatusText" Text="请启动游戏" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LaunchStatusPercent" Grid.Column="1" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="LaunchProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0"/>
                                <TextBlock x:Name="LaunchStatusDetail" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                           Text="选择版本后点击「启动游戏」"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

        <Border x:Name="LoginOverlay" Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush x:Name="OverlayBrush" Color="Black" Opacity="0"/>
            </Border.Background>
            <Grid Background="Transparent" MouseLeftButtonDown="LoginOverlay_Click">
                <Border x:Name="LoginCard" Style="{DynamicResource CardStyle}"
                        Width="360" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="24" Background="{DynamicResource ReadablePanelBrush}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CardScale" ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform x:Name="CardTranslate" Y="20"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="切换登录方式" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>
                        <RadioButton Grid.Row="1" x:Name="PopupOfflineRadio" Content="离线模式" Style="{DynamicResource NavBtn}"
                                     GroupName="PopupAuth" Click="PopupAuth_Click" Tag="offline"/>
                        <Grid Grid.Row="2" x:Name="PopupOfflinePanel" Visibility="Visible" Margin="24,0,0,0" Opacity="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="玩家名" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,4"/>
                            <TextBox Grid.Row="1" x:Name="PopupOfflineNameBox" Height="32" FontSize="14"
                                     behavior:InputValidationBehavior.IdentifierOnly="True"/>
                        </Grid>
                        <RadioButton Grid.Row="3" x:Name="PopupExternalRadio" Content="第三方登录" Style="{DynamicResource NavBtn}"
                                     GroupName="PopupAuth" Click="PopupAuth_Click" Tag="external"/>
                        <Grid Grid.Row="4" x:Name="PopupExternalPanel" Visibility="Collapsed" Margin="24,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="认证服务器" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,4"/>
                            <TextBox Grid.Row="1" x:Name="PopupAuthServerBox" Height="32" FontSize="14"
                                     Text="https://littleskin.cn/api/yggdrasil"/>
                            <TextBlock Grid.Row="3" Text="账号" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox Grid.Row="4" x:Name="PopupAuthAccountBox" Height="32" FontSize="14"/>
                            <TextBlock Grid.Row="6" Text="密码" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <Grid Grid.Row="7" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox Grid.Column="0" x:Name="PopupAuthPasswordBox" FontSize="14"
                                             Tag="password"/>
                                <TextBox Grid.Column="0" x:Name="PopupAuthPasswordShow" FontSize="14"
                                         Visibility="Collapsed" Tag="password"/>
                                <Button Grid.Column="1" x:Name="PasswordToggleBtn" Width="32" Height="32"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="PasswordToggle_Click" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock x:Name="PasswordToggleIcon" Text="👁" FontSize="14"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton x:Name="PopupMicrosoftRadio" Content="正版登录" Style="{DynamicResource NavBtn}"
                                         GroupName="PopupAuth" Click="PopupAuth_Click" Tag="microsoft"/>
                            <TextBlock x:Name="PopupMicrosoftStatus" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" x:Name="PopupMicrosoftPanel" Visibility="Collapsed" Margin="24,0,0,0">
                            <TextBlock Text="已保存的正版账户" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,4"/>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PopupMicrosoftAccountBox" Grid.Column="0" Height="32"/>
                                <Button x:Name="PopupMicrosoftUseBtn" Grid.Column="2" Content="使用账户"
                                        Style="{DynamicResource BtnBase}" Padding="10,4"
                                        Click="UseMicrosoftAccount_Click"/>
                            </Grid>
                            <TextBlock Text="网页授权完成后会自动保存，可在这里快速切换。" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="PopupMicrosoftCancelBtn" Content="取消网页授权"
                                    Style="{DynamicResource BtnDanger}" Padding="10,4"
                                    Margin="0,8,0,0" HorizontalAlignment="Center"
                                    Click="CancelMicrosoftLogin_Click" Visibility="Collapsed"/>
                            <Button x:Name="PopupMicrosoftRemoveBtn" Content="移除所选账户" Style="{DynamicResource BtnBase}"
                                    Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Center"
                                    Click="RemoveMicrosoftAccount_Click"/>
                        </StackPanel>
                        <Button Grid.Row="7" x:Name="PopupLoginBtn" Content="登录" Style="{DynamicResource BtnPrimary}"
                                Height="38" Padding="24,0" Click="PopupLogin_Click" Margin="0,14,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="LaunchSuccessToast" Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,24" Panel.ZIndex="999"
                Style="{DynamicResource CardStyle}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x2714;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="游戏启动成功" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="正在等待游戏窗口出现，请稍候..." FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
