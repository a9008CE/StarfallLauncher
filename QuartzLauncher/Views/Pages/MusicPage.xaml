<Page x:Class="QuartzLauncher.Views.Pages.MusicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Background="#0B1220">
    <!-- 整页只留播放器本体：无标题、无工具栏、无边框 -->
    <Grid ClipToBounds="True">
        <wv2:WebView2 x:Name="Player" Visibility="Collapsed"/>

        <StackPanel x:Name="OfflinePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="460" Margin="24">
            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="OfflineTitle" Text="正在连接音乐服务…"
                       Style="{DynamicResource PageTitle}" FontSize="17"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="OfflineHint" Text=""
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
            <Button x:Name="RetryBtn" Content="重试" Style="{DynamicResource BtnBase}"
                    Width="96" Height="34" Margin="0,16,0,0" HorizontalAlignment="Center"
                    Visibility="Collapsed" Click="Retry_Click"/>
        </StackPanel>
    </Grid>
</Page>
