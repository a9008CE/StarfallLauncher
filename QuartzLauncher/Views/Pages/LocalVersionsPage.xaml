<Page x:Class="QuartzLauncher.Views.Pages.LocalVersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      AllowDrop="True"
      DragOver="FolderDragOver"
      Drop="FolderDrop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="VersionListBar" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                AllowDrop="True" DragOver="FolderDragOver" Drop="FolderDrop"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="14,10,14,10">
                        <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand"
                                Click="Back_Click"/>
                        <TextBlock Text="本地版本" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Margin="16,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Column="0" Content="安装新版本" Style="{DynamicResource BtnPrimary}" Height="34" Padding="16,4"
                                Click="InstallVersion_Click"/>
                        <Button Grid.Column="2" Content="添加已有文件夹" Style="{DynamicResource BtnBase}" Height="34" Padding="8,4"
                                Click="AddExistingFolder_Click"/>
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="复制选中版本（独立副本）"
                                Style="{DynamicResource BtnBase}" Height="34" Padding="8,4"
                                Click="DuplicateVersion_Click"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="24,0,24,8"/>
                </StackPanel>

                <Grid>
                    <TextBlock x:Name="EmptyHint" Text="暂无已下载版本"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ListBox x:Name="VersionList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="VersionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="8,2" Background="Transparent"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="6"
                                                Background="{DynamicResource CardSurfaceBrush}">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding VersionLabel}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CreatedLabel}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <Frame x:Name="DetailFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
               Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
    </Grid>
</Page>
