<Page x:Class="QuartzLauncher.Views.Pages.MultiplayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="LobbyView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,24" MaxWidth="800">

                <!-- 防滥用门槛（达标后隐藏） -->
                <Border x:Name="GateCard" Style="{DynamicResource CardStyle}" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="GateTitle" Text="暂不可用" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="GateMessage" FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <ProgressBar x:Name="GateProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,16,0,0" Foreground="{DynamicResource PrimaryBrush}"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="GateDetail" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 大厅 -->
                <Grid x:Name="LobbyRoot" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LobbyTitle" Text="联机大厅" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Tag="搜索房间" Grid.Column="1" Width="150" Height="30" FontSize="12"
                                 Margin="16,0,0,0" VerticalContentAlignment="Center" MaxLength="6"
                                 ToolTip="输入 6 位房间号搜索"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="LobbyStatus" Grid.Column="3" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="RefreshBtn" Grid.Column="4" Content="刷新"
                                Style="{DynamicResource BtnBase}" Padding="14,6"
                                Click="Refresh_Click"/>
                    </Grid>

                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="暂无公开房间"
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,32,0,0" HorizontalAlignment="Center"/>

                    <StackPanel x:Name="RoomList" Grid.Row="2"/>
                </Grid>

                <!-- 房间详情 -->
                <Border x:Name="DetailCard" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DetailName" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="DetailMeta" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="DetailAddrText" FontSize="13" FontFamily="Consolas"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <Button x:Name="CopyAddrBtn" Content="复制" Style="{DynamicResource BtnBase}"
                                    Padding="10,3" Margin="8,0,0,0" FontSize="11"
                                    Click="CopyAddr_Click"/>
                        </StackPanel>

                        <TextBlock x:Name="DetailMods" FontSize="11" FontFamily="Consolas"
                                   Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="180"
                                   Foreground="{DynamicResource TextMutedBrush}"/>

                        <TextBlock x:Name="PasswordLabel" Text="联机密码" FontSize="12" Margin="0,16,0,6"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox x:Name="PasswordBox" Height="32" FontSize="13" MaxLength="16"
                                 Visibility="Collapsed"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>

                        <TextBlock x:Name="JoinHint" FontSize="12" Margin="0,14,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="收起" Style="{DynamicResource BtnBase}"
                                    Height="36" Padding="16,4" Margin="0,0,8,0"
                                    Click="Back_Click"/>
                            <Button x:Name="JoinBtn" Content="加入房间" Style="{DynamicResource BtnPrimary}"
                                    Height="36" Padding="20,4" Click="Join_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 世界聊天（侧栏视图）-->
        <Grid x:Name="ChatView" Grid.Column="1" Visibility="Collapsed" Margin="36,26,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="世界聊天" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="ChatChannelText" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" MinHeight="320">
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatMessages"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="ChatStatus" Grid.Row="2" FontSize="11" Margin="0,8,0,6"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" Tag="说点什么…" Grid.Column="0" Height="34" FontSize="12"
                             VerticalContentAlignment="Center" KeyDown="ChatInput_KeyDown"/>
                    <Button Grid.Column="1" Content="发图" Style="{DynamicResource BtnBase}"
                            Height="34" Padding="14,2" Margin="8,0,0,0" Click="ChatImage_Click"/>
                    <Button Grid.Column="2" Content="发送" Style="{DynamicResource BtnPrimary}"
                            Height="34" Padding="18,2" Margin="8,0,0,0" Click="ChatSend_Click"/>
                </Grid>
        </Grid>

        <!-- 我的房间（侧栏视图）-->
        <Grid x:Name="MyRoomsView" Grid.Column="1" Visibility="Collapsed" Margin="36,26,36,24">
            <StackPanel>
                <TextBlock Text="我的房间" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <Border Style="{DynamicResource CardStyle}" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="当前没有正在发布的房间" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="在游戏里对局域网开放世界，启动器会自动发现并询问是否发布；发布后可以在这里查看房间码与连接地址。"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 好友（侧栏视图）-->
        <Grid x:Name="FriendsView" Grid.Column="1" Visibility="Collapsed" Margin="36,26,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="好友" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>

                <!-- 未登录：注册 / 登录 -->
                <StackPanel x:Name="FriendAuthPanel" Margin="0,12,0,0">
                    <TextBlock Text="登录后才能云端同步好友（注册需绑定邮箱，登录可用「邮箱或编码」）"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="注册账号" Style="{DynamicResource BtnPrimary}" Height="36"
                                Padding="20,2" Click="Register_Click"/>
                        <Button Content="登录" Style="{DynamicResource BtnBase}" Height="36"
                                Padding="20,2" Margin="10,0,0,0" Click="Login_Click"/>
                        <Button Content="找回编码" Style="{DynamicResource BtnBase}" Height="36"
                                Padding="20,2" Margin="10,0,0,0" Click="RecoverCode_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 已登录：我的编码 + 账号操作 -->
                <!-- 账户信息：压缩成一张小卡（编码 + 复制 + 账户管理）-->
                <Border x:Name="FriendAccountPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        Style="{DynamicResource CardStyle}" Padding="12,7">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="我的编码" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="MyCodeText" FontSize="16" FontWeight="Bold"
                                       FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <Button Content="复制" Style="{DynamicResource BtnBase}" Height="26"
                                    Padding="10,2" Margin="10,0,0,0" Click="CopyCode_Click"/>
                            <Button x:Name="ReLoginBtn" Content="重新登录" Style="{DynamicResource BtnPrimary}"
                                    Height="26" Padding="10,2" Margin="6,0,0,0" Visibility="Collapsed"
                                    Click="ReLogin_Click"/>
                            <Button Content="账户管理" Style="{DynamicResource BtnBase}" Height="26"
                                    Padding="10,2" Margin="6,0,0,0" Click="AccountManage_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="MyAccountHint" FontSize="10" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 添加好友（按对方的 9 位编码）-->
                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FriendNameBox" Tag="对方编码" Grid.Column="0" Height="34" FontSize="12"
                             VerticalContentAlignment="Center" MaxLength="9"
                             ToolTip="输入对方的 9 位编码（在对方的「我的编码」里查看）"/>
                    <Button Grid.Column="1" Content="添加好友" Style="{DynamicResource BtnPrimary}"
                            Height="34" Padding="16,2" Margin="8,0,0,0" Click="AddFriend_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="刷新好友" Style="{DynamicResource BtnBase}" Height="30"
                            Padding="12,2" Click="RefreshFriends_Click"/>
                    <TextBlock x:Name="FriendAutoRefreshHint" FontSize="11" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                               Text="（停留在本页时每 15 秒自动刷新）"/>
                </StackPanel>

                <TextBlock x:Name="FriendStatusText" FontSize="11" Margin="0,0,0,8"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" MinHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FriendList"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 私聊（点好友进入）-->
        <Grid x:Name="PrivateChatView" Grid.Column="1" Visibility="Collapsed" Margin="36,26,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="← 返回好友" Style="{DynamicResource BtnBase}" Height="30" Padding="12,2"
                        Click="PrivateChatBack_Click"/>
                <TextBlock x:Name="PrivateChatTitle" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextBrush}"/>
            </Grid>

            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" MinHeight="300">
                <ScrollViewer x:Name="PrivateChatScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PrivateChatMessages"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="PrivateChatStatus" Grid.Row="2" FontSize="11" Margin="0,8,0,6"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PrivateChatInput" Grid.Column="0" Height="34" FontSize="13"
                         VerticalContentAlignment="Center" Tag="发消息给好友…" KeyDown="PrivateChatInput_KeyDown"/>
                <Button Grid.Column="1" Content="发图" Style="{DynamicResource BtnBase}" Height="34"
                        Padding="14,2" Margin="8,0,0,0" Click="PrivateChatImage_Click"/>
                <Button Grid.Column="2" Content="发送" Style="{DynamicResource BtnPrimary}" Height="34"
                        Padding="18,2" Margin="8,0,0,0" Click="PrivateChatSend_Click"/>
            </Grid>
        </Grid>

        <!-- 图片预览浮层（双击聊天里的图片打开，点击关闭）-->
        <Border x:Name="ChatImagePreview" Grid.ColumnSpan="2" Visibility="Collapsed"
                Background="#E6000000" MouseLeftButtonUp="ChatImagePreview_Click">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="ChatImagePreviewImage" MaxWidth="900" MaxHeight="620"
                       Stretch="Uniform"/>
                <TextBlock Text="点击任意位置关闭" FontSize="12" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
