<Page x:Class="QuartzLauncher.Views.Pages.ServerBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具行 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="210" Height="30" Margin="0,0,10,8"
                         Padding="10,0" VerticalContentAlignment="Center"
                         ToolTip="搜索服务器名称、简介或版本（当前已加载的页）"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="SortBox" Width="140" Height="30" Margin="0,0,10,8"
                          VerticalContentAlignment="Center" SelectionChanged="SortBox_SelectionChanged"
                          ToolTip="排序方式">
                    <ComboBoxItem Content="默认顺序" Tag="default" IsSelected="True"/>
                    <ComboBoxItem Content="人数多 → 少" Tag="players"/>
                    <ComboBoxItem Content="延迟低 → 高" Tag="ping"/>
                    <ComboBoxItem Content="名称 A → Z" Tag="name"/>
                </ComboBox>
                <CheckBox x:Name="ModOnlyCheck" Content="只看 Mod 服务器" FontSize="12"
                          VerticalAlignment="Center" Margin="0,0,4,8"
                          Click="ModOnly_Click"/>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="AllButton" Content="全部" Style="{DynamicResource BtnPrimary}"
                        Padding="12,6" Margin="0,0,6,0" Click="Region_Click" Tag="all"/>
                <Button x:Name="DomesticButton" Content="国内" Style="{DynamicResource BtnBase}"
                        Padding="12,6" Margin="0,0,6,0" Click="Region_Click" Tag="cn"/>
                <Button x:Name="ForeignButton" Content="国外" Style="{DynamicResource BtnBase}"
                        Padding="12,6" Margin="0,0,12,0" Click="Region_Click" Tag="foreign"/>
                <Button Content="刷新" Style="{DynamicResource BtnBase}" Padding="12,6"
                        Margin="0,0,10,0" Click="Refresh_Click"/>
                <Button x:Name="RetryButton" Content="重试" Style="{DynamicResource BtnBase}"
                        Padding="12,6" Margin="0,0,12,0" Visibility="Collapsed" Click="Retry_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ServerPanel" MaxWidth="860" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <Border x:Name="LoadingOverlay" Grid.Row="1" Background="Transparent"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="48" Height="48" ClipToBounds="False">
                    <Path x:Name="SpinnerPath" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 24,4 A 20,20 0 1 1 4,24">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                            </Style>
                        </Path.Style>
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" CenterX="24" CenterY="24"/>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
                <TextBlock Text="正在加载服务器列表" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,14,0,0">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text"
                                        BeginTime="0:0:0">
                                        <DiscreteStringKeyFrame KeyTime="0:0:0" Value="正在加载服务器列表"/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:0.5" Value="正在加载服务器列表."/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:1.0" Value="正在加载服务器列表.."/>
                                        <DiscreteStringKeyFrame KeyTime="0:0:1.5" Value="正在加载服务器列表..."/>
                                    </StringAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="PreviousButton" Content="上一页" Style="{DynamicResource BtnBase}"
                    Padding="14,6" Click="Previous_Click"/>
            <TextBlock x:Name="PageText" Text="1 / 1" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="18,0"/>
            <Button x:Name="NextButton" Content="下一页" Style="{DynamicResource BtnBase}"
                    Padding="14,6" Click="Next_Click"/>
        </StackPanel>
    </Grid>
</Page>
