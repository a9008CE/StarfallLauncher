<Page x:Class="QuartzLauncher.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behavior="clr-namespace:QuartzLauncher.Services"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24" MaxWidth="750">
            <TextBlock Text="SETTINGS" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="启动设置" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="配置 Java、登录方式、内存和下载并发数。" Style="{DynamicResource PageSubtitle}"/>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="当前选择的 Java" Style="{DynamicResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Grid.Column="0" Height="36"
                                 Margin="0,0,12,0" IsReadOnly="True" FontSize="13"/>
                        <Button Grid.Column="1" Content="检测" Style="{DynamicResource BtnBase}" Padding="14,7"
                                Click="DetectJava_Click"/>
                        <Button Grid.Column="2" Content="浏览" Style="{DynamicResource BtnBase}" Padding="12,7"
                                Margin="8,0,0,0" Click="BrowseJava_Click"/>
                        <Button Grid.Column="3" Content="显示路径" Style="{DynamicResource BtnBase}" Padding="12,7"
                                Margin="8,0,0,0" Click="ShowSelectedJavaPath_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="扫描目录" Style="{DynamicResource BtnBase}" Padding="12,5"
                                Click="ScanJavaFolder_Click" ToolTip="可选择任意磁盘目录查找 Java"/>
                        <Button x:Name="FullScanJavaButton" Content="全盘扫描" Style="{DynamicResource BtnBase}"
                                Padding="12,5" Margin="8,0,0,0" Click="ScanAllJava_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="JavaInfoText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="可选的 Java 安装:" FontSize="13" Margin="0,16,0,8"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="JavaSelector" Height="36" VerticalContentAlignment="Center"
                              SelectionChanged="JavaSelector_SelectionChanged"/>
                    <CheckBox x:Name="AutoSelectJavaCheck" Content="按 Minecraft 版本自动选择 Java（推荐）"
                              FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0"
                              Click="AutoSelectJava_Changed"/>
                    <TextBlock Text="启动时优先使用实例专用 Java，再查找匹配版本；找不到时会提示下载。"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="版本隔离" Style="{DynamicResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="隔离方式:" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                        <ComboBox x:Name="VersionIsolationCombo" Grid.Column="1" Height="36"
                                  VerticalContentAlignment="Center" SelectionChanged="VersionIsolation_Changed">
                            <ComboBoxItem Content="不隔离" Tag="none"/>
                            <ComboBoxItem Content="仅隔离含 Mod 的版本" Tag="modded"/>
                            <ComboBoxItem Content="隔离所有版本" Tag="all"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="VersionIsolationInfoText" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="内存设置" Style="{DynamicResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="AutoMemoryCheck" Content="自动分配内存"
                                  Click="AutoMemory_Changed" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                        <Button x:Name="RecommendBtn" Content="查看推荐值" Style="{DynamicResource BtnBase}"
                                Padding="10,3" Margin="12,0,0,0" Click="Recommend_Click"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最大内存:" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                        <Slider x:Name="MemorySlider" Grid.Column="1" Minimum="512" Maximum="16384"
                                TickFrequency="512" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="Memory_Changed"/>
                        <TextBlock x:Name="MemoryText" Grid.Column="2" Text="4096 MB" Width="80"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                    </Grid>
                    <TextBlock x:Name="MemoryInfoText" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,6,0,0"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="每次启动时进行运存优化" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" x:Name="MemoryOptimizeSwitch"
                                      Style="{DynamicResource IosSwitch}" VerticalAlignment="Center"
                                      ToolTip="启动前整理物理内存（裁剪进程工作集 + 清空系统备用内存），并按 Java 版本自动调优 GC（ZGC/G1GC）。清空备用内存需要管理员权限；该操作会延长启动耗时，建议仅在内存不足时开启。"
                                      Click="MemoryOptimize_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="下载设置" Style="{DynamicResource SectionHeader}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="下载源:" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                        <ComboBox x:Name="SourceCombo" Grid.Column="1" Height="36" VerticalContentAlignment="Center"
                                   SelectionChanged="Source_Changed">
                            <ComboBoxItem Content="Mojang 官方" Tag="mojang"/>
                            <ComboBoxItem Content="BMCLAPI 镜像" Tag="bmclapi"/>
                            <ComboBoxItem Content="混合源（优先镜像源）" Tag="hybrid_priority"/>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="并发数:" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                        <Slider x:Name="WorkersSlider" Grid.Column="1" Minimum="1" Maximum="128"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="Workers_Changed"/>
                        <TextBlock x:Name="WorkersText" Grid.Column="2" Text="64" Width="30"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                    </Grid>
                    <CheckBox x:Name="AutoInstallLoaderCheck" Margin="0,8,0,0"
                              FontSize="12" Foreground="{DynamicResource TextBrush}"
                              ToolTip="下载版本时自动安装所选的 Mod 加载器">
                        <TextBlock Text="下载版本时自动安装 Mod 加载器" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="启动器更新" Style="{DynamicResource SectionHeader}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="UpdateStatusText" Text="可从本机更新服务检查新版本。"
                                FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="更新清单地址" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBox x:Name="UpdateManifestUrlBox" FontSize="12" MinHeight="36" Padding="6,4"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,6"/>
                    <CheckBox x:Name="RunAsUpdateServerCheck" Content="本机作为根更新服务器（启动器启动时自动运行更新服务）"
                              FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock Text="局域网客户端请填写服务器电脑的 LAN IP，例如 http://192.168.1.3:47831/update.json；不要填写 127.0.0.1。"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UpdateModeButton" Content="自动获取更新" Style="{DynamicResource BtnBase}"
                                Padding="12,6" Click="UpdateMode_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CheckUpdateButton" Content="获取更新" Style="{DynamicResource BtnPrimary}"
                                Padding="14,6" Click="CheckUpdate_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="保存设置" Style="{DynamicResource BtnPrimary}" Height="42" FontSize="14"
                    Click="Save_Click" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
