<Page x:Class="QuartzLauncher.Views.Pages.VersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:QuartzLauncher.Services"
      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
      Background="Transparent">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="LIBRARY" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="版本与实例" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="管理 Minecraft 版本和游戏实例。" Style="{DynamicResource PageSubtitle}" Margin="0,0,0,4"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Minecraft 版本"
                                       Style="{DynamicResource SectionHeader}" VerticalAlignment="Center"/>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
                                <Button Content="导入整合包" Style="{DynamicResource BtnBase}"
                                        MinWidth="88" MinHeight="30" Padding="10,5"
                                        Click="ImportModpack_Click" Margin="0,0,6,6"/>
                                <Button Content="正式版" Style="{DynamicResource BtnBase}"
                                        MinHeight="30" Padding="10,5"
                                        Click="FilterRelease_Click" Margin="0,0,6,6" x:Name="BtnRelease"/>
                                <Button Content="预览版" Style="{DynamicResource BtnBase}"
                                        MinHeight="30" Padding="10,5"
                                        Click="FilterSnapshot_Click" Margin="0,0,6,6" x:Name="BtnSnapshot"/>
                                <Button Content="愚人节版" Style="{DynamicResource BtnBase}"
                                        MinHeight="30" Padding="10,5"
                                        Click="FilterAprilFools_Click" Margin="0,0,6,6" x:Name="BtnAprilFools"/>
                                <Button Content="刷新" Style="{DynamicResource BtnBase}"
                                        MinHeight="30" Padding="10,5" Margin="0,0,0,6"
                                        Click="Refresh_Click"/>
                            </WrapPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center"
                                     Padding="4,0" FontSize="13"/>
                            <TextBlock Text="搜索版本..." IsHitTestVisible="False" Padding="14,0"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                       VerticalAlignment="Center" x:Name="SearchPlaceholder"/>
                        </Grid>
                        <ListBox Grid.Row="2" x:Name="VersionListBox" BorderThickness="0"
                                  SelectionChanged="Version_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.Resources>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Setter Property="local:SmoothScrollBehavior.StepPixels" Value="30"/>
                                    <Setter Property="local:SmoothScrollBehavior.LerpFactor" Value="0.1"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.RenderTransform>
                                <TranslateTransform x:Name="VersionListTranslate"/>
                            </ListBox.RenderTransform>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="VanillaBar" Style="{DynamicResource CardStyle}" Margin="0,0,0,16"
                        Cursor="Hand" MouseLeftButtonDown="VanillaBar_Click">
                    <TextBlock Text="▸ 安装原版" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>

                <Border Grid.Row="0" x:Name="VanillaCard" Style="{DynamicResource CardStyle}" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="安装原版" Style="{DynamicResource SectionHeader}" VerticalAlignment="Center"/>
                            <Button Content="收起" Style="{DynamicResource BtnBase}" Padding="8,4"
                                    Click="VanillaCollapse_Click" HorizontalAlignment="Right" FontSize="11"/>
                        </DockPanel>
                        <TextBlock x:Name="SelectedVersionText" Text="选择左侧版本" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="VersionTypeText" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                        <Button x:Name="InstallBtn" Content="安装此版本" Style="{DynamicResource BtnPrimary}"
                                Height="40" Padding="20,0" IsEnabled="False" Click="Install_Click"/>
                        <TextBlock x:Name="InstallStatusText" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="CreateTitle" Text="创建实例" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" x:Name="InstanceNameLabel" Text="实例名称" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Grid.Row="2" x:Name="InstanceNameBox" Height="36" VerticalContentAlignment="Center"
                                 Text="我的世界" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="3" Text="Mod 加载器" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button Grid.Row="4" x:Name="LoaderSelectBtn" Content="选择加载器..."
                                Style="{DynamicResource BtnBase}" Height="36" HorizontalAlignment="Stretch"
                                Click="LoaderSelect_Click" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" x:Name="LoaderInfoText" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="原版 (无 Mod 加载器)" Margin="0,0,0,14"/>

                        <Button Grid.Row="6" x:Name="CreateInstanceBtn" Content="创建实例"
                                Style="{DynamicResource BtnPrimary}"
                                Height="40" IsEnabled="False" Click="CreateInstance_Click"/>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
