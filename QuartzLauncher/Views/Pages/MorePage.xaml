<Page x:Class="QuartzLauncher.Views.Pages.MorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:QuartzLauncher.Services"
      Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="MoreBar" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10,0,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand"
                            Click="Back_Click" Margin="16,0,0,0"/>
                    <TextBlock Text="更多功能" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}"
                        Margin="24,4,24,8"/>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <RadioButton x:Name="NavTheme" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 IsChecked="True" Click="NavTheme_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="主题" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavModDownload" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 Click="NavModDownload_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="资源中心设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPreset3" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 Click="NavPreset3_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="动画设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPreset4" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 Click="NavPreset4_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="网站站点" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPreset5" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 Click="NavPreset5_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="下载管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMapDownload" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 Click="NavMapDownload_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="地图下载" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPreset6" Style="{DynamicResource NavBtn}" GroupName="MoreNav"
                                 Click="NavPreset6_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="皮肤/预览" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,8">
                    <TextBlock x:Name="FooterHint" Text="拖动模型可以旋转。导入的 64x64 或 64x32 皮肤会保存在启动器配置目录中。"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <TextBlock Text="{x:Static services:UpdateService.DisplayVersion}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                               Opacity="0.6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Frame x:Name="MoreFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
               Background="Transparent"
               SnapsToDevicePixels="True" UseLayoutRounding="True"/>
    </Grid>
</Page>
