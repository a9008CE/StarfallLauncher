<Page x:Class="QuartzLauncher.Views.Pages.SkinPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="SKIN" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="皮肤/预览" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="导入本地 Minecraft 皮肤 PNG，并在启动器内查看 3D 预览。" Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="1" MaxWidth="980" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="128" Height="128" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SidebarBrush}"
                            VerticalAlignment="Top">
                        <Image x:Name="SkinImage" Stretch="Uniform" Margin="8"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="当前皮肤" Style="{DynamicResource SectionHeader}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SkinPathText" Text="未导入皮肤" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Grid Grid.Column="4" Width="350" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Button Content="使用当前皮肤" Style="{DynamicResource BtnBase}" Click="UseCurrentSkin_Click" Margin="0,0,0,8"/>
                            <Button Content="皮肤库" Style="{DynamicResource BtnBase}" Click="SkinLibrary_Click" Margin="0,0,0,8"/>
                            <Button x:Name="ToggleModelBtn" Content="切换至 Alex 模型" Style="{DynamicResource BtnBase}" Click="ToggleModel_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Button Content="导入皮肤 PNG" Style="{DynamicResource BtnBase}" Click="Import_Click" Margin="0,0,0,8"/>
                            <Button Content="设为启动器头像" Style="{DynamicResource BtnBase}" Click="UseAsAvatar_Click" Margin="0,0,0,8"/>
                            <Button Content="清除皮肤" Style="{DynamicResource BtnBase}" Click="Clear_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,18,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="皮肤预设" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
                    <Button Content="走路" Tag="走路" Style="{DynamicResource BtnBase}" Click="Preset_Click" Margin="0,0,0,8"/>
                    <Button Content="跑步" Tag="跑步" Style="{DynamicResource BtnBase}" Click="Preset_Click" Margin="0,0,0,8"/>
                    <Button Content="游泳" Tag="游泳" Style="{DynamicResource BtnBase}" Click="Preset_Click" Margin="0,0,0,8"/>
                    <Button Content="坐下" Tag="坐下" Style="{DynamicResource BtnBase}" Click="Preset_Click" Margin="0,0,0,8"/>
                    <Button Content="默认" Tag="默认" Style="{DynamicResource BtnBase}" Click="Preset_Click" Margin="0,0,0,12"/>
                      <Button x:Name="WineBtn" Content="邦友的酒" Style="{DynamicResource BtnBase}" Click="BangyouWine_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Style="{DynamicResource CardStyle}"
                    HorizontalAlignment="Stretch"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                <Grid>
                    <Viewport3D x:Name="SkinViewport" ClipToBounds="True"
                                MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                MouseMove="Preview_MouseMove">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,15,62" LookDirection="0,-1,-62" UpDirection="0,1,0" FieldOfView="32"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup x:Name="SceneRoot">
                                    <AmbientLight Color="#B8FFFFFF"/>
                                    <DirectionalLight Color="#FFFFFFFF" Direction="-0.45,-0.7,-0.35"/>
                                    <DirectionalLight Color="#66FFFFFF" Direction="0.6,-0.3,0.6"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                    </Viewport3D>
                    <TextBlock x:Name="EmptyHint" Text="导入 PNG 后显示 3D 预览" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
