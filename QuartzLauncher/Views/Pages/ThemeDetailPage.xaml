<Page x:Class="QuartzLauncher.Views.Pages.ThemeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24" MaxWidth="750">
            <TextBlock Text="THEME" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="主题设置" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="UI 风格与配色方案。" Style="{DynamicResource PageSubtitle}"/>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="UI 风格" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
                    <WrapPanel x:Name="UiStylePanel"/>
                </StackPanel>
            </Border>

            <Border x:Name="CustomBackgroundCard" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="自定义背景" Style="{DynamicResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="CustomBackgroundStatus" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="24,0,0,0">
                            <Button Content="打开图库目录" Style="{DynamicResource BtnBase}" Padding="12,6"
                                    Click="OpenBackgroundFolder_Click"/>
                            <Button x:Name="SyncPresetsButton" Content="下载官方预设图"
                                    Style="{DynamicResource BtnBase}" Padding="12,6" Margin="8,0,0,0"
                                    ToolTip="从 starfallmc.top 拉取官方预设图库到图库目录"
                                    Click="SyncPresets_Click"/>
                            <Button x:Name="ChooseBackgroundButton" Content="选择图片"
                                    Style="{DynamicResource BtnBase}" Padding="12,6" Margin="8,0,0,0"
                                    Click="ChooseBackground_Click"/>
                            <Button x:Name="ClearBackgroundButton" Content="取消固定"
                                    Style="{DynamicResource BtnBase}" Padding="12,6" Margin="8,0,0,0"
                                    ToolTip="取消当前固定的图片，文件仍保留在图库中"
                                    Click="ClearBackground_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="预设图库" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,14,0,8"/>
                    <WrapPanel x:Name="BackgroundPresetPanel"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="轮播背景" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="CarouselStatus" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="24,0,0,0">
                            <ComboBox x:Name="CarouselSecondsBox" Width="86" Height="28" FontSize="11"
                                      SelectionChanged="CarouselSeconds_SelectionChanged"/>
                            <ToggleButton x:Name="BackgroundCarouselSwitch" Style="{DynamicResource IosSwitch}"
                                          Margin="10,0,0,0" Click="BackgroundCarousel_Click"
                                          VerticalAlignment="Center"
                                          ToolTip="按间隔轮播图库中的全部背景"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="侧栏布局" Style="{DynamicResource SectionHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="让侧栏导航文字与图标从左侧对齐。" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="SidebarTextLeftSwitch" Grid.Column="1"
                                  Style="{DynamicResource IosSwitch}" IsChecked="True"
                                  ToolTip="切换侧栏文字对齐方式" Click="SidebarTextAlignment_Click"
                                  VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="资源中心样式" Style="{DynamicResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBlock Text="影响 Mods 搜索、光影包、资源包界面的展示方式（不影响下载管理和下载设置）。"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ListStyleBtn" Content="列表式" Style="{DynamicResource ToggleBtn}"
                                     GroupName="ResourceCenterStyle" Tag="list" Margin="0,0,8,0"
                                     Click="ResourceStyle_Click"/>
                        <RadioButton x:Name="GridStyleBtn" Content="大图式" Style="{DynamicResource ToggleBtn}"
                                     GroupName="ResourceCenterStyle" Tag="grid"
                                     Click="ResourceStyle_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="显示模式" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="DarkBtn" Content="深色" Style="{DynamicResource ToggleBtn}"
                                     Click="DarkMode_Click" Margin="0,0,8,0"/>
                        <RadioButton x:Name="LightBtn" Content="浅色" Style="{DynamicResource ToggleBtn}"
                                     Click="LightMode_Click"/>
                    </StackPanel>
                    <TextBlock Text="配色方案" Style="{DynamicResource SectionHeader}" Margin="0,0,0,12"/>
                    <WrapPanel x:Name="ThemePanel"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
