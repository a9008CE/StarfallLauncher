<Page x:Class="QuartzLauncher.Views.Pages.FeedbackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="FEEDBACK" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock Text="问题反馈" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="遇到 bug、游戏崩溃或者想提建议，写在这里直接发给我们。会自动带上环境信息和最近的游戏日志，不用你手动找。"
                       Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap"/>

            <!-- 类型 -->
            <TextBlock Text="问题类型" Style="{DynamicResource SectionHeader}" Margin="0,20,0,8"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BugRadio" Content="功能异常 / BUG" IsChecked="True"
                             GroupName="fbkind" Foreground="{DynamicResource TextBrush}" Margin="0,0,22,0"/>
                <RadioButton x:Name="CrashRadio" Content="游戏报错 / 崩溃"
                             GroupName="fbkind" Foreground="{DynamicResource TextBrush}" Margin="0,0,22,0"/>
                <RadioButton x:Name="IdeaRadio" Content="建议 / 想要的功能"
                             GroupName="fbkind" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <!-- 描述 -->
            <TextBlock Text="发生了什么" Style="{DynamicResource SectionHeader}" Margin="0,18,0,8"/>
            <TextBox x:Name="MessageBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="10,8" FontSize="13"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     ToolTip="尽量写清楚：点了什么、看到什么、期望是什么。"
                     TextChanged="MessageBox_TextChanged"/>
            <TextBlock x:Name="MessageHint" Text="至少写 4 个字" FontSize="11" Margin="2,4,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>

            <!-- 联系方式 -->
            <TextBlock Text="联系方式（可选）" Style="{DynamicResource SectionHeader}" Margin="0,16,0,8"/>
            <TextBox x:Name="ContactBox" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                     FontSize="13" MaxLength="80"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     ToolTip="QQ / 邮箱 / 群昵称都行，方便我们回复你。"/>

            <!-- 日志开关与目录 -->
            <CheckBox x:Name="IncludeLogsCheck" Content="附带最近的游戏日志与崩溃报告（推荐，方便定位）"
                      IsChecked="True" Margin="0,16,0,0" FontSize="12"
                      Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="打开日志目录" Style="{DynamicResource BtnBase}" Padding="12,5"
                        Margin="0,0,8,0" Click="OpenLogs_Click"/>
                <Button Content="打开崩溃报告目录" Style="{DynamicResource BtnBase}" Padding="12,5"
                        Click="OpenCrashReport_Click"/>
            </StackPanel>

            <!-- 环境信息预览 -->
            <Expander Margin="0,18,0,0" Foreground="{DynamicResource TextBrush}">
                <Expander.Header>
                    <TextBlock Text="查看会自动附带的环境信息" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Expander.Header>
                <TextBox x:Name="DiagBox" IsReadOnly="True" Height="150" Margin="0,8,0,0"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="{DynamicResource InputBgBrush}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>
            </Expander>

            <!-- 操作 -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="SubmitButton" Content="提交反馈" Style="{DynamicResource BtnPrimary}"
                        Padding="20,8" Click="Submit_Click"/>
                <Button Content="复制诊断信息" Style="{DynamicResource BtnBase}" Padding="14,8"
                        Margin="10,0,0,0" Click="Copy_Click"/>
                <Button Content="保存到桌面" Style="{DynamicResource BtnBase}" Padding="14,8"
                        Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock FontSize="11" Margin="0,8,0,30" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="说明：日志只读取本实例的 logs/latest.log 与最新一份 crash-reports，不会上传存档、账号或其它文件。"/>
        </StackPanel>
    </ScrollViewer>
</Page>
