<Page x:Class="QuartzLauncher.Views.Pages.VersionSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:QuartzLauncher.Services"
      Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border x:Name="PresetBar" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10,0,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button Content="&#xE72B;" AutomationProperties.Name="返回" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand"
                            Click="Back_Click" Margin="16,0,0,0"/>
                    <TextBlock Text="版本设置" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}"
                        Margin="24,4,24,8"/>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <RadioButton x:Name="NavDetail" Style="{DynamicResource NavBtn}" GroupName="PresetNav"
                                 IsChecked="True" Click="Detail_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="详细信息" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMods" Style="{DynamicResource NavBtn}" GroupName="PresetNav"
                                 Click="Preset1_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Mod 管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSaves" Style="{DynamicResource NavBtn}" GroupName="PresetNav"
                                 Click="Preset2_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="存档管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavResourcePacks" Style="{DynamicResource NavBtn}" GroupName="PresetNav"
                                 Click="Preset3_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="材质包设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavShaderPacks" Style="{DynamicResource NavBtn}" GroupName="PresetNav"
                                 Click="Preset4_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="光影包设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPreset5" Style="{DynamicResource NavBtn}" GroupName="PresetNav"
                                 Click="Preset5_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource NavTextAlignment}">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="导出数据" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{x:Static services:UpdateService.DisplayVersion}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="24,0,24,8" Opacity="0.6"/>
            </DockPanel>
        </Border>


        <Frame x:Name="PresetFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
               Background="Transparent"
               SnapsToDevicePixels="True" UseLayoutRounding="True"/>
    </Grid>
</Page>
