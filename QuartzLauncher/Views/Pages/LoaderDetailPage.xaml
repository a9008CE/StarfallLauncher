<Page x:Class="QuartzLauncher.Views.Pages.LoaderDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24">
            <TextBlock x:Name="EyebrowText" Text="LOADER" Style="{DynamicResource PageEyebrow}"/>
            <TextBlock x:Name="TitleText" Style="{DynamicResource PageTitle}"/>
            <TextBlock x:Name="DescText" Style="{DynamicResource PageSubtitle}" Margin="0,0,0,16"/>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="版本选择" Style="{DynamicResource SectionHeader}" Margin="0,0,0,10"/>
                        <ListBox x:Name="VersionList" BorderThickness="0" MaxHeight="100"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="FabricApiPanel" Visibility="Collapsed">
                        <TextBlock Text="Fabric API" Style="{DynamicResource SectionHeader}" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <CheckBox x:Name="FabricApiCheck" Content="同时安装 Fabric API"
                                          FontSize="12" Foreground="{DynamicResource TextBrush}"
                                          IsChecked="True" Margin="0,0,0,8"
                                          ToolTip="Fabric API 为许多 Fabric Mod 提供核心功能支持"/>
                                <TextBlock x:Name="FabricApiVersionText" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="说明" Style="{DynamicResource SectionHeader}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="InfoText" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                    <Button x:Name="ConfirmBtn" Content="确认选择" Style="{DynamicResource BtnPrimary}"
                            Height="40" Padding="20,0" Click="Confirm_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
